{
  "name": "terrarium-renderer",
  "version": "0.1.0",
  "type": "module",
  "description": "Canvas land and water ecosystem scenes with nest inspection",
  "license": "MIT",
  "author": "zhiyuxl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhiyuHD/terrarium-renderer.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
